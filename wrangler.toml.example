name = "swamig-application"
pages_build_output_dir = "."
compatibility_date = "2026-07-16"

# Replace the database ID, then rename this file to wrangler.toml.
[[d1_databases]]
binding = "DB"
database_name = "yourbabalawo-db"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"
migrations_dir = "migrations"

# For local development only. This bypass works only on localhost.
[vars]
ALLOW_UNVERIFIED_LOCAL = "true"
